# ---- Appwrite core ----
APPWRITE_VERSION=1.8.1
_APP_ENV=production
_APP_OPENSSL_KEY_V1=change_this_to_a_long_random_secret


# ---- Domains ----
_APP_DOMAIN=appwrite.example.com
_APP_DOMAIN_TARGET=appwrite.example.com
_APP_DOMAIN_FUNCTIONS=functions.appwrite.example.com


# ---- Database (MariaDB) ----
_APP_DB_HOST=mariadb
_APP_DB_PORT=3306
_APP_DB_SCHEMA=appwrite
_APP_DB_USER=appwrite
_APP_DB_PASS=change_db_password
_APP_DB_ROOT_PASS=change_root_password


# ---- Redis ----
_APP_REDIS_HOST=redis
_APP_REDIS_PORT=6379
_APP_REDIS_PASS=

#--- Runtimes ---
_APP_FUNCTIONS_RUNTIMES=node-16.0,node-18.0,node-20.0,php-8.0,python-3.9,ruby-3.0


# ---- Functions / Executor ----n_APP_FUNCTIONS_RUNTIMES=node-18.0,php-8.2,python-3.11
_APP_EXECUTOR_SECRET=change_executor_secret


# ---- Optional / Recommended ----
_APP_USAGE_STATS=enabled
_APP_LOGGING_CONFIG=




_APP_OPTIONS_FORCE_HTTPS=enabled
_APP_OPTIONS_FUNCTIONS_FORCE_HTTPS=enabled
_APP_OPTIONS_ROUTER_FORCE_HTTPS=enabled

_APP_SYSTEM_EMAIL_NAME=EmailSender
_APP_SYSTEM_EMAIL_ADDRESS=info@mysmtp.com
_APP_SMTP_HOST=smtp.hostinger.com
_APP_SMTP_PORT=587
_APP_SMTP_SECURE=tls
_APP_SMTP_USERNAME=user
_APP_SMTP_PASSWORD=pass

_APP_SYSTEM_SECURITY_EMAIL_ADDRESS=myemail@host.com
_APP_EMAIL_CERTIFICATES=myemail@host.com


_APP_WORKER_PER_CORE=10
_APP_EXECUTOR_HOST=http://openruntimes-executor